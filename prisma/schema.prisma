generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  startDate   DateTime
  endDate     DateTime
  location    String
  sessions    Session[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Session {
  id          String    @id @default(cuid())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  capacity    Int?      
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id])
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  speakers    SpeakerOnSession[]
  questions   Question[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Room {
  id        String    @id @default(cuid())
  name      String    @unique
  sessions  Session[]
  createdAt DateTime  @default(now())
}

model Speaker {
  id          String    @id @default(cuid())
  name        String
  photoUrl    String?
  bio         String?
  externalUrl String?
  sessions    SpeakerOnSession[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SpeakerOnSession {
  speakerId   String
  sessionId   String
  speaker     Speaker   @relation(fields: [speakerId], references: [id])
  session     Session   @relation(fields: [sessionId], references: [id])

  @@id([speakerId, sessionId])
}

model Question {
  id          String    @id @default(cuid())
  content     String
  authorName  String?   
  upvotes     Int       @default(0)
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}